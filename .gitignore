# Build output.
#
# Anchored, because a bare `build/` matches a directory called build at *any*
# depth. Unanchored, it silently swallowed the whole of windows/build/ - the
# PyInstaller recipe, which belongs in the repository - and the first thing
# anybody heard about it was CI failing on a requirements.txt that was right
# there locally.
/build/
app/build/
.gradle/
.kotlin/
*.apk

# ...except the prebuilt debug APK that ships with the repo.
!dist/*.apk
*.aab
*.ap_
*.dex
*.class

# Local configuration
local.properties
.cxx/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]

# What PyInstaller writes. The recipe beside it, windows/build/, is kept.
/dist-windows/build/

# The exe itself is never committed. It lives on the release for the tag that
# built it, which is what latest.json points at. A 15 MB binary added once per
# version is 15 MB added to every clone of this project for ever, and
# raw.githubusercontent is a source viewer rather than a download CDN.
/dist-windows/*.exe
.build-venv/

# Personal permission rules, not part of the project
.claude/settings.local.json
